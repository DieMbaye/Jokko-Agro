{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "user-select",
          "-moz-appearance",
          "scrollbar-width",
          "scrollbar-width: none",
          "scrollbar-color",
          "scrollbar-width: thin",
          "-webkit-overflow-scrolling",
          "forced-color-adjust",
          "forced-color-adjust: none",
          "color: color-mix(in srgb, var(--lc) 80%, #fff)",
          "border: 1px solid color-mix(in srgb, var(--lc) 25%, transparent)",
          "border-color: color-mix(in srgb, var(--lc) 50%, transparent)",
          "border: 1px solid color-mix(in srgb,var(--lc) 25%,transparent)",
          "border-color: color-mix(in srgb,var(--lc) 50%,transparent)",
          "color: color-mix(in srgb,var(--lc) 80%,#fff)"
        ]
      }
    ],
    "axe/text-alternatives": [
      "default",
      {
        "image-alt": "off"
      }
    ],
    "no-inline-styles": "off",
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "input[capture]",
          "textarea[autocapitalize]"
        ]
      }
    ],
    "axe/forms": [
      "default",
      {
        "label": "off",
        "select-name": "off"
      }
    ],
    "axe/structure": [
      "default",
      {
        "list": "off"
      }
    ]
  }
}